rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Kullanıcı kökü: okuma/yazma yalnızca kendi UID'siyle.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Memories: client okuyabilir ve silebilir (hafızayı temizle),
      // ancak create/update yalnızca backend (Admin SDK) tarafında.
      match /memories/{memoryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // Readings: yalnızca backend yazar; client okur.
      match /readings/{readingId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Predictions (ledger): backend-only.
      match /predictions/{predictionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Conversations + messages: client okur, backend yazar.
      match /conversations/{conversationId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // Usage sayaçları: backend-only, maliyet kontrolü buradan yapılır.
      match /usage/{period} {
        allow read: if false;
        allow write: if false;
      }
    }

    // Diğer her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
